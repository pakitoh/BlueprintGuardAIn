# Application
ANALYSIS_APP_NAME="analysis-worker"
ANALYSIS_LOG_LEVEL="DEBUG"

# Kafka
ANALYSIS_KAFKA_BOOTSTRAP_SERVERS="localhost:9094"
ANALYSIS_SCHEMA_REGISTRY_URL="http://localhost:8081"
ANALYSIS_WEBHOOK_EVENTS_TOPIC="webhook-events"
ANALYSIS_RESULTS_TOPIC="analysis-results"
ANALYSIS_CONSUMER_GROUP_ID="analysis-worker-group"

# Observability
ANALYSIS_OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"

# Gemini API
ANALYSIS_LLM_API_KEY=MY_SECRET_API_KEY
ANALYSIS_LLM_MODEL=gemini/gemini-2.5-flash-lite
ANALYSIS_EMBEDDING_MODEL=gemini/gemini-embedding-2