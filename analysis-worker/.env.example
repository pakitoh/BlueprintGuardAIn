# Application
APP_NAME="BlueprintGuardAIn Analysis Worker"
LOG_LEVEL="INFO"

# Kafka
KAFKA_BOOTSTRAP_SERVERS="localhost:9094"
WEBHOOK_EVENTS_TOPIC="webhook-events"
ANALYSIS_RESULTS_TOPIC="analysis-results"
CONSUMER_GROUP_ID="analysis-worker-group"

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT="http://otel-collector:4317"
OTEL_SERVICE_NAME="analysis-worker"
