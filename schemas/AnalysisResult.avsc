{
  "type": "record",
  "name": "AnalysisResult",
  "namespace": "com.blueprint.guardain",
  "fields": [
    {
      "name": "repository",
      "type": "string"
    },
    {
      "name": "sha",
      "type": "string"
    },
    {
      "name": "status",
      "type": "string"
    },
    {
      "name": "findings",
      "type": {
        "type": "array",
        "items": "string"
      }
    },
    {
      "name": "timestamp",
      "type": "string",
      "doc": "ISO-8601 timestamp when the analysis completed"
    },
    {
      "name": "ingested_at",
      "type": ["null", "string"],
      "default": null,
      "doc": "ISO-8601 timestamp when the CodeChange was first received; used for end-to-end pipeline duration"
    }
  ]
}
